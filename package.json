{
  "name": "@anoesj/eslint-config-vue-ts",
  "version": "0.7.0",
  "description": "Anoesj's ESLint config for Vue and Nuxt projects with TypeScript",
  "author": "Anoesj Sadraee (https://github.com/anoesj)",
  "license": "MIT",
  "homepage": "https://github.com/anoesj/eslint-config-vue-ts#readme",
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anoesj/eslint-config-vue-ts.git"
  },
  "bugs": {
    "url": "https://github.com/anoesj/eslint-config-vue-ts/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "inspect": "eslint-config-inspector",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "release": "bumpp"
  },
  "peerDependencies": {
    "eslint": ">= 10"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.5.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
