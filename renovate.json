{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "timezone": "Europe/Brussels",
  "schedule": [
    "* 8-13 1,15 * *"
  ],
  "updateNotScheduled": false,
  "packageRules": [
    {
      "description": "TypeScript 7 drops the JS API that typescript-eslint needs (peer: typescript <6.1.0)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ]
}
